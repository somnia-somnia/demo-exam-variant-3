erDiagram
    users ||--o{ bookings : creates
    bookings ||--o{ reviews : receives
    users {
        bigint id PK
        longtext login
        longtext password_hash
        longtext full_name
        longtext phone
        longtext email
        varchar_64 login_key UK
        tinyint_1 is_admin
    }
    bookings {
        bigint id PK
        bigint user_id FK
        longtext car
        longtext payment
        date start_date
        longtext status
    }
    reviews {
        bigint id PK
        bigint booking_id FK
        longtext text
    }
